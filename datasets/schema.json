{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceForge FAQ evaluation dataset",
  "type": "object",
  "required": ["dataset_id", "description", "cases"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "question", "evidence", "required_keywords", "retrieval_keywords"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "required_keywords": {"type": "array", "items": {"type": "string"}},
          "retrieval_keywords": {"type": "array", "items": {"type": "string"}},
          "prompt_overrides": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
